<Project>
  <!-- SPDX-License-Identifier: MIT
       Part of the Geoland library: unofficial, fan-made mods for HavenCraft.
       HavenCraft is the work of Dionic Software; this project is not affiliated with them.

       Build settings shared by every plugin. Each plugin's project file imports this
       one. The plugins are compiled against the game's own assemblies and the mod
       loader's, which are found in the game folder named by GameDir below; none of
       them is copied into the build output. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- The game folder to build against: a copy with the BepInEx mod loader installed. -->

    <GameDir>$(MSBuildThisFileDirectory)..\HavenCraft_Alpha-6.0.5\HavenCraft_Alpha-6.0.5</GameDir>
    <NoWarn>$(NoWarn);CS0436;MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared code is compiled into each plugin, so every plugin is a single file
         that works on its own. -->

    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" LinkBase="Shared" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\Unity.*.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\Haven.*.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\Dionic.*.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\HavenCraft_Data\Managed\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>
